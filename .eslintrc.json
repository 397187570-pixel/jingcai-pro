{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "CONFIG": "readonly",
    "esc": "readonly",
    "safeHtml": "readonly",
    "TODAY_MATCHES": "writable",
    "State": "writable",
    "TEAMS": "writable",
    "fetchWithTimeout": "readonly",
    "Parlay": "writable",
    "toast": "readonly",
    "renderToolbox": "readonly",
    "renderOdds": "readonly",
    "renderAI": "readonly",
    "renderAnalysis": "readonly",
    "switchPage": "readonly",
    "eloPredict": "readonly",
    "kellyIndex": "readonly",
    "poisson": "readonly",
    "factorial": "readonly",
    "H2H": "readonly",
    "FACTORS": "readonly",
    "COMPARE_METRICS": "readonly",
    "BOOKMAKERS": "readonly",
    "SCORE_ODDS": "readonly",
    "TOTAL_GOALS_ODDS": "readonly",
    "HTFT_ODDS": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-var": "error",
    "prefer-const": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-func-assign": "error",
    "no-unreachable": "error",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-extra-semi": "error",
    "no-cond-assign": ["error", "always"],
    "no-irregular-whitespace": "error",
    "no-redeclare": "error",
    "valid-typeof": "error",
    "use-isnan": "error",
    "no-shadow": "off",
    "no-magic-numbers": "off",
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "indent": ["warn", 2, { "SwitchCase": 1 }]
  },
  "ignorePatterns": ["node_modules/", "dist/", "*.min.js"]
}
